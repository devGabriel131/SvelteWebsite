{
	"name": "sveltewebsite",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tools.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"db:up": "docker compose up -d --wait --wait-timeout 90 postgres",
		"db:down": "docker compose down",
		"db:status": "docker compose ps",
		"db:shell": "docker compose exec postgres psql -U sveltewebsite -d sveltewebsite",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/db/migrate.ts",
		"db:seed": "bun scripts/db/seed.ts",
		"db:seed:subject-scores": "bun scripts/db/seed-subject-scores.ts",
		"db:seed:admin": "bun scripts/db/seed-admin.ts",
		"db:seed:bootcamp": "bun scripts/db/seed-bootcamp.ts",
		"db:test:up": "docker compose -f compose.test.yaml up -d --wait --wait-timeout 90 postgres",
		"db:test:down": "docker compose -f compose.test.yaml down",
		"db:test": "TEST_DATABASE_URL=postgresql://sveltewebsite_test:sveltewebsite_test@127.0.0.1:5434/sveltewebsite_test bun test --timeout 15000 tests/database"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.52.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4",
		"@types/bun": "^1.4.2",
		"@types/nodemailer": "^8.0.2",
		"@types/pdfkit": "^0.17.6",
		"bits-ui": "^2.18.0",
		"cn": "^0.4.0",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"svelte-language-server": "^0.18.4",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-language-server": "^6.0.1",
		"vite": "^8.3.0",
		"vscode-langservers-extracted": "^4.10.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.7",
		"better-auth": "1.7.7",
		"drizzle-orm": "^0.45.3",
		"exceljs": "4.4.0",
		"nodemailer": "^10.0.16",
		"pdfkit": "^0.20.2",
		"postgres": "^3.4.9"
	}
}
